# انسخ الملف ده إلى .env (متسيبش مفاتيح حقيقية في .env.example).
# FREE option: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-3.8-flash
# بدائل تلقائية لو الموديل غير متاح أو الحد المجاني خلص:
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-2.5-flash

# ---------------------------- المدرّس الذكي ----------------------------
# Paid option (needs OpenAI credits): uncomment to use instead
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-key
# OPENAI_MODEL=gpt-4.1-mini

# ------------------------- الحسابات (Supabase) -------------------------
# من Supabase → Settings → API:  Project URL  و  service_role key
# من غيرهم: الموقع بيشتغل عادي بس من غير تسجيل/تفعيل (وده الوضع الحالي).
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=replace-with-service-role-key

# ----------------------------- لوحة الأدمن -----------------------------
# ADMIN_USER اختياري (الافتراضي: admin). ADMIN_PASSWORD إجباري لفتح اللوحة.
# SESSION_SECRET نصّ عشوائي طويل — بيلغي جلسات الأدمن لو اتغيّر.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-string

PORT=4173
